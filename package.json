{
  "name": "@deepseek-ai/dsh-plugin-pomodoro",
  "version": "1.1.3",
  "private": true,
  "description": "番茄时钟：专注 / 短休 / 长休倒计时浮层与偏好设置",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "src/engine.js",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node tools/build-client.cjs",
    "test": "node tools/check-build.cjs && node tools/test-runner.cjs && node tools/host.test.mjs",
    "test:engine": "node tools/test-runner.cjs tools/engine.test.cjs",
    "test:browser": "node tools/test-runner.cjs tools/browser.test.cjs",
    "test:host": "node tools/host.test.mjs",
    "sync": "powershell -NoProfile -File tools/sync-plugin.ps1"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dlfhome/dsh-plugin-pomodoro.git"
  },
  "homepage": "https://github.com/dlfhome/dsh-plugin-pomodoro#readme",
  "bugs": {
    "url": "https://github.com/dlfhome/dsh-plugin-pomodoro/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "pomodoro",
    "番茄时钟",
    "cordis"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
